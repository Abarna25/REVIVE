# REVIVE™ Environment Configuration Template

# Node Environment ('development' | 'production')
NODE_ENV=development
PORT=5000

# Frontend URLs (for CORS in production backend)
FRONTEND_URL=http://localhost:5173

# Client API Base URL (Used by Vite client build)
VITE_API_URL=http://localhost:5000

# PostgreSQL Database (Supabase / Render / Local)
# Leave empty to run in zero-config REVIVE™ In-Memory Store Mode
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?schema=public
DIRECT_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?schema=public

# Payment Execution Mode ('simulation' | 'razorpay_test')
PAYMENT_MODE=simulation
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AI Intelligence Engine ('enabled' | 'fallback')
AI_MODE=enabled
AI_API_KEY=

# Demo Data Seeding ('true' | 'false')
DEMO_MODE=true
